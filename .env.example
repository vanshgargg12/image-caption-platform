# Frontend (Next.js)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Backend (Spring Boot)
BACKEND_PORT=8080
INFERENCE_BASE_URL=http://localhost:3001

# Inference (Node.js internal service)
INFERENCE_PORT=3001
MODEL_ID=Xenova/vit-gpt2-image-captioning
MODEL_REVISION=main
MODEL_CACHE_DIR=.model-cache
MAX_IMAGE_SIZE_BYTES=10485760
INFERENCE_TIMEOUT_MS=30000
MAX_CONCURRENT_INFERENCE=1
# Generation Settings (ViT-GPT2)
CAPTION_MAX_NEW_TOKENS=24
CAPTION_NUM_BEAMS=4
CAPTION_NO_REPEAT_NGRAM=3
CAPTION_REPETITION_PENALTY=1.0

# Generation Settings (Florence-2)
FLORENCE2_MAX_NEW_TOKENS_SHORT=40
FLORENCE2_MAX_NEW_TOKENS_DETAILED=120
FLORENCE2_NUM_BEAMS=3

# Database (reserved for a later phase; not used in MVP scaffolding)
DATABASE_URL=postgresql://localhost:5432/image_caption
POSTGRES_DB=image_caption
POSTGRES_USER=image_caption
POSTGRES_PASSWORD=change-me
